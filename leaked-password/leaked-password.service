[Unit]
Description=Leaked Password Checker Web Service
After=network.target

[Service]
User=rpi
WorkingDirectory=/home/rpi/rpi/leaked-password
Environment=PYTHONPATH=/home/rpi/rpi/leaked-password
ExecStart=/home/rpi/rpi/leaked-password/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target