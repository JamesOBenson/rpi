[Unit]
Description=STEM Buddy voice assistant
After=network.target sound.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONPATH=__DIR__
ExecStartPre=__DIR__/scripts/setup_audio.sh
ExecStart=__DIR__/venv/bin/python src/main.py
Restart=always

[Install]
WantedBy=multi-user.target
